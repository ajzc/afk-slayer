      "binding": "DB",
      "database_name": "afk-slayer-db",
      "database_id": "d2c1421b-9551-4132-bfd1-906eb79bab43"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SAVES",
      "id": "bc779518ea564e36bca1f1f1c3ac3fb6"
    }
  ],
  "vars": {
    "GOOGLE_CLIENT_ID": "210972017284-5gec5vvc11j99746h11mti4956rebosi.apps.googleusercontent.com"
  }
}
